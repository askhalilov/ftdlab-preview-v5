VITE_AFFILIATE_URL=
VITE_ADVERTISER_URL=

VITE_DRUK_FONT_URL=
VITE_HELVETICA_FONT_URL=

# Desktop only: living (default), or whole-body for the original fallback.
VITE_DESKTOP_MASCOT=living

# Local preview defaults. GitHub Actions sets its own staging values.
# Cloudflare production: VITE_SITE_ENV=production, VITE_BASE_PATH=/,
# VITE_PUBLIC_ORIGIN=https://ftdlab.net.
VITE_BASE_PATH=./
VITE_SITE_ENV=preview
VITE_PUBLIC_ORIGIN=
